{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahal-pro-test",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "env": {
    "production": {
      "name": "rahal-pro",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "alrhalpro.com",
          "custom_domain": true
        },
        {
          "pattern": "www.alrhalpro.com",
          "custom_domain": true
        }
      ]
    }
  }
}
